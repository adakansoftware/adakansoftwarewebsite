# Resend API key - iletisim formu e-postalarini gondermek icin
# https://resend.com adresinden ucretsiz hesap ac
# Ucretsiz planda 3.000 e-posta/ay
RESEND_API_KEY=re_your_production_key_here

# Gonderici domain (Resend'de dogrulanmis domain olmali)
# Dogrulanmamis domain icin onboarding@resend.dev kullanilabilir
RESEND_FROM_DOMAIN=your-verified-domain.example

# Site URL - production'da tam URL, development'ta otomatik
NEXT_PUBLIC_SITE_URL=https://adakansoftware.com

# WhatsApp iletisim numarasi - ulke kodu dahil, + olmadan
NEXT_PUBLIC_WHATSAPP_NUMBER=905399416521

# Contact API guvenlik ayarlari
# Production'da origin kontrolu site URL uzerinden calisir.
# Development'ta localhost origin'leri otomatik kabul edilir.
CONTACT_RATE_LIMIT_WINDOW_MS=60000
CONTACT_RATE_LIMIT_MAX_REQUESTS=4
CONTACT_DUPLICATE_WINDOW_MS=600000
CONTACT_IDEMPOTENCY_WINDOW_MS=600000
CONTACT_MAX_CONTENT_LENGTH=12000
CONTACT_DELIVERY_TIMEOUT_MS=8000
CONTACT_OUTBOX_RETENTION_MS=604800000
CONTACT_OUTBOX_REPLAY_BATCH_SIZE=25
CONTACT_OUTBOX_REPLAY_LOCK_MS=30000
CONTACT_REPLAY_AUDIT_RETENTION=100
CONTACT_OUTBOX_CLAIM_LEASE_MS=45000
CONTACT_OUTBOX_RETRY_BASE_DELAY_MS=30000
CONTACT_OUTBOX_RETRY_MAX_DELAY_MS=900000
CONTACT_OUTBOX_MAX_ATTEMPTS=8
CONTACT_QUEUE_ALERT_AGE_MS=1800000
# Production'da CONTACT_ADMIN_KEY veya CONTACT_ADMIN_SIGNING_SECRET zorunludur.
# En az 32 karakter kullanin; varsayilan/yer tutucu degerler kabul edilmez.
CONTACT_ADMIN_KEY=change-this-admin-key
CONTACT_ADMIN_SIGNING_SECRET=change-this-signing-secret
# Otomatik replay etkinlestirilecekse en az 32 karakterlik benzersiz bir secret kullanin.
CONTACT_CRON_SECRET=change-this-cron-secret
# Vercel Cron kullaniliyorsa platformun CRON_SECRET degeri de kabul edilir.
CRON_SECRET=change-this-vercel-cron-secret
# Local gelistirme icin file kullanilabilir; production'da redis zorunludur.
CONTACT_STATE_BACKEND=file
REDIS_URL=redis://127.0.0.1:6379
CONTACT_STATE_REDIS_PREFIX=contact-state
CONTACT_WORKER_BASE_URL=http://127.0.0.1:3000
CONTACT_WORKER_BATCH_SIZE=25
CONTACT_WORKER_ID=worker-local-1
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Production IP rate limiting only trusts Vercel's x-vercel-forwarded-for header.
